# TaskFlow Environment Variables Configuration
# Copy this file to .env or set these in your hosting environment.
# NEVER commit real private keys or secrets to version control.

# ==========================================
# Frontend Configuration (Vite)
# Exposed to client browser via import.meta.env
# ==========================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_API_BASE_URL=/api/v1

# ==========================================
# Backend Configuration (FastAPI)
# Kept strictly server-side; NEVER expose to client
# ==========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
FRONTEND_ORIGIN=http://localhost:3000
PORT=8000


